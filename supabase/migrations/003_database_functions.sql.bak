-- 003_database_functions.sql
-- Secure server-side functions for checkout and demo payments

-- ============================================
-- create_order function
-- ============================================

CREATE OR REPLACE FUNCTION create_order(
  p_user_id UUID,
  p_shipping_full_name TEXT,
  p_shipping_phone TEXT,
  p_shipping_address TEXT,
  p_shipping_city TEXT,
  p_shipping_state TEXT,
  p_shipping_postal_code TEXT,
  p_payment_method TEXT,
  p_idempotency_key UUID
)
RETURNS TABLE (
  order_id UUID,
  total_amount NUMERIC,
  payment_status TEXT,
  order_status TEXT
)
LANGUAGE plpgsql
AS $$
DECLARE
  v_subtotal NUMERIC := 0;
  v_shipping_fee NUMERIC := 0;
  v_discount NUMERIC := 0;
  v_total NUMERIC := 0;
  v_order_id UUID;
  v_existing_order UUID;
BEGIN
  -- 1. Validate authenticated customer
  IF p_user_id IS NULL THEN
    RAISE EXCEPTION 'User not authenticated';
  END IF;

  -- 2. Check idempotency (prevent duplicate orders)
  SELECT id INTO v_existing_order 
  FROM orders 
  WHERE idempotency_key = p_idempotency_key 
  AND user_id = p_user_id
  LIMIT 1;

  IF v_existing_order IS NOT NULL THEN
    RETURN QUERY SELECT v_existing_order, total_amount, payment_status, order_status
    FROM orders WHERE id = v_existing_order;
  -- 6. Validate stock for each cart item
  FOR v_stock_check IN 
    SELECT ci.id as cart_item_id, p.stock as product_stock, ci.quantity as requested_qty
    FROM cart_items ci
    JOIN products p ON p.id = ci.product_id
    WHERE ci.user_id = p_user_id
  LOOP
    IF v_stock_check.product_stock < v_stock_check.requested_qty THEN
      RAISE EXCEPTION 'Insufficient stock. Available: %, Requested: %', 
        v_stock_check.product_stock, v_stock_check.requested_qty;
    END IF;
  END LOOP;

  -- 7. Create the order
  INSERT INTO orders (
    user_id, subtotal, shipping_fee, discount, total_amount,
    payment_method, payment_status, order_status,
    shipping_full_name, shipping_phone, shipping_address,
    shipping_city, shipping_state, shipping_postal_code,
    idempotency_key
  ) VALUES (
    p_user_id, v_subtotal, v_shipping_fee, v_discount, v_total,
    p_payment_method, 
    CASE WHEN p_payment_method = 'cod' THEN 'PENDING' ELSE 'PENDING' END,
    'PLACED',
    p_shipping_full_name, p_shipping_phone, p_shipping_address,
    p_shipping_city, p_shipping_state, p_shipping_postal_code,
    p_idempotency_key
  ) RETURNING id INTO v_order_id;

  -- 8. Create order item snapshots and decrement stock
  FOR v_stock_check IN 
    SELECT ci.id as cart_item_id, p.id as product_id, p.name as product_name,
           ci.size, ci.color, ci.quantity,
           COALESCE(p.discount_price, p.price) as unit_price,
           COALESCE(p.discount_price, p.price) * ci.quantity as line_total
    FROM cart_items ci
    JOIN products p ON p.id = ci.product_id
    WHERE ci.user_id = p_user_id
  LOOP
    INSERT INTO order_items (
      order_id, product_id, product_name, size, color,
      quantity, unit_price, line_total
    ) VALUES (
      v_order_id, v_stock_check.product_id, v_stock_check.product_name,
      v_stock_check.size, v_stock_check.color,
      v_stock_check.quantity, v_stock_check.unit_price, v_stock_check.line_total
    );

    -- 9. Decrement stock safely
    UPDATE products 
    SET stock = stock - v_stock_check.quantity, updated_at = NOW()
    WHERE id = v_stock_check.product_id;
  END LOOP;

  -- 10. Clear cart after successful order creation
  DELETE FROM cart_items WHERE user_id = p_user_id;

  RETURN QUERY SELECT v_order_id, v_total, 'PENDING', 'PLACED';
END;
-- ============================================
-- process_demo_payment function
-- ============================================

CREATE OR REPLACE FUNCTION process_demo_payment(
  p_order_id UUID,
  p_transaction_reference TEXT,
  p_payment_method TEXT,
  p_amount NUMERIC,
  p_simulate_success BOOLEAN,
  p_is_demo BOOLEAN
)
RETURNS TABLE (
  payment_id UUID,
  transaction_reference TEXT,
  status TEXT,
  amount NUMERIC
)
LANGUAGE plpgsql
AS $$
DECLARE
  v_order_user_id UUID;
  v_order_total NUMERIC;
  v_order_payment_status TEXT;
  v_existing_payment UUID;
  v_payment_status TEXT;
  v_payment_id UUID;
BEGIN
  -- 1. Validate order exists and get details
  SELECT user_id, total_amount, payment_status INTO v_order_user_id, v_order_total, v_order_payment_status
  FROM orders WHERE id = p_order_id;

  IF v_order_user_id IS NULL THEN
    RAISE EXCEPTION 'Order not found';
  END IF;

  -- 2. Validate authenticated user owns the order
  IF v_order_user_id <> auth.uid() THEN
    RAISE EXCEPTION 'Unauthorized: You do not own this order';
  END IF;

  -- 3. Validate amount matches order total
  IF p_amount <> v_order_total THEN
    RAISE EXCEPTION 'Payment amount does not match order total';
  END IF;

  -- 4. Prevent duplicate successful payment processing
  IF v_order_payment_status = 'SUCCESS' THEN
    RAISE EXCEPTION 'Payment already processed for this order';
  END IF;

  -- 5. Check for existing successful payment
  SELECT id INTO v_existing_payment
  FROM payments
  WHERE order_id = p_order_id AND status = 'SUCCESS'
  LIMIT 1;

  IF v_existing_payment IS NOT NULL THEN
    RAISE EXCEPTION 'A successful payment already exists for this order';
  END IF;

  -- 6. Determine payment status
  IF p_simulate_success THEN
    v_payment_status := 'SUCCESS';
  ELSE
    v_payment_status := 'FAILED';
  END IF;

  -- 7. Create payment record
  INSERT INTO payments (
    order_id, transaction_reference, payment_method,
    amount, status, is_demo
  ) VALUES (
    p_order_id, p_transaction_reference, p_payment_method,
    p_amount, v_payment_status, p_is_demo
  ) RETURNING id INTO v_payment_id;

  -- 8. Update order payment status based on result
  IF v_payment_status = 'SUCCESS' THEN
    UPDATE orders 
    SET payment_status = 'SUCCESS', 
        order_status = 'CONFIRMED',
        updated_at = NOW()
    WHERE id = p_order_id;
  ELSE
    UPDATE orders 
    SET payment_status = 'FAILED',
        updated_at = NOW()
    WHERE id = p_order_id;
  END IF;

  RETURN QUERY SELECT v_payment_id, p_transaction_reference, v_payment_status, p_amount;
END;
$$;
$$;
    RETURN;
  END IF;

  -- 3. Calculate cart totals from database (not trusted client data)
  SELECT 
    COALESCE(SUM(
      COALESCE(p.discount_price, p.price) * ci.quantity
    ), 0) INTO v_subtotal
  FROM cart_items ci
  JOIN products p ON p.id = ci.product_id
  WHERE ci.user_id = p_user_id
  AND p.is_active = true;

  -- 4. Validate cart is not empty
  IF v_subtotal = 0 THEN
    RAISE EXCEPTION 'Cart is empty or contains no available products';
  END IF;

  -- 5. Calculate shipping (free above ₹2999)
  IF v_subtotal >= 2999 THEN
    v_shipping_fee := 0;
  ELSE
    v_shipping_fee := 99;
  END IF;

  v_total := v_subtotal + v_shipping_fee;
